

FROM node:22 AS frontend-build
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm install --no-audit --no-fund --prefer-offline
COPY frontend/ .
RUN npm run build || ./node_modules/.bin/vite build

FROM node:22-alpine AS backend-compile
WORKDIR /app/backend
RUN apk add --no-cache python3 make g++ sqlite-dev
COPY backend/package.json ./
RUN rm -f package-lock.json && npm install --no-audit --no-fund --prefer-offline
COPY backend/src ./src
COPY backend/tsconfig.json ./
RUN npm run build
RUN npm prune --production


FROM node:22-alpine AS production
WORKDIR /backend
RUN mkdir -p /backend/data && chown -R node:node /backend


RUN apk update && apk upgrade --no-cache && \
    apk add --no-cache sqlite libstdc++ libgcc

COPY --from=backend-compile /app/backend/node_modules ./node_modules
COPY --from=backend-compile /app/backend/dist ./dist
COPY --from=frontend-build /app/frontend/dist ./public

USER node
EXPOSE 3000
VOLUME ["/backend/data"]
CMD ["node", "dist/index.js"]
